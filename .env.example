# ============================================
# 环境配置示例文件
# 复制此文件为 .env 并填入真实配置
# 注意：.env 文件不会被提交到 Git
# ============================================

# ============================================
# Gemini LLM 配置
# ============================================
GEMINI_API_KEY=你的 Gemini API 密钥
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL_NAME=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL_NAME=gemini-3.1-flash-lite-preview

# ============================================
# 邮箱配置
# ============================================
EMAIL_SMTP_SERVER=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SENDER=你的 QQ 邮箱
EMAIL_AUTH_CODE=你的 QQ 邮箱 SMTP 授权码
EMAIL_RECEIVER=接收通知的邮箱地址

# ============================================
# PostgreSQL 数据库配置 (本地 NAS)
# ============================================
DATABASE_URL=postgresql://用户名:密码@数据库地址:5432/数据库名

# ============================================
# Web 查看器登录配置
# ============================================
WEB_PASSWORD=请设置一个强密码
WEB_SECRET_KEY=请设置一段随机长字符串

# ============================================
# Valkey / Redis 缓存配置
# ============================================
VALKEY_URI=redis://localhost:6379/0

# ============================================
# 服务配置
# ============================================
ASR_SERVER_HOST=0.0.0.0
ASR_SERVER_PORT=5008
WEB_VIEWER_PORT=5009
ASR_TRANSCRIBE_URL=http://localhost:5008/transcribes

# ============================================
# 多设备 SSH 无感恢复上传配置
# （仅监控上传停滞并自动恢复，不参与语音识别）
# ============================================
# 要监控的设备名称列表，逗号分隔
RECOVERY_DEVICE_NAMES=Sony-1,Sony-3

# 设备记录文件根目录（每个设备的目录名默认为设备名）
RECOVERY_BASE_DIR=/Volumes/download/records

# ---------- Sony-1 设备配置 ----------
# IP: 192.168.1.192
RECOVERY_SONY_1_SSH_HOST=192.168.1.192
RECOVERY_SONY_1_SSH_PORT=8022
RECOVERY_SONY_1_SSH_USER=root
RECOVERY_SONY_1_SSH_PASSWORD=
RECOVERY_SONY_1_RECOVERY_COMMAND=/data/data/com.termux/files/home/all_in_one.sh start
RECOVERY_SONY_1_ENABLED=true
# 停滞阈值（秒），超过此时间无新文件则触发告警和恢复
RECOVERY_SONY_1_STALL_TIMEOUT=1800
# 自动恢复冷却期（秒），避免频繁重复执行恢复
RECOVERY_SONY_1_RECOVERY_COOLDOWN=1800
# SSH 命令超时时间（秒）
RECOVERY_SONY_1_RECOVERY_TIMEOUT=90
# 监控活跃时段（小时），仅在此时间段内检测
RECOVERY_SONY_1_ACTIVE_HOUR_START=6
RECOVERY_SONY_1_ACTIVE_HOUR_END=23

# ---------- Sony-3 设备配置 ----------
# IP: 192.168.1.195
RECOVERY_SONY_3_SSH_HOST=192.168.1.195
RECOVERY_SONY_3_SSH_PORT=8022
RECOVERY_SONY_3_SSH_USER=root
RECOVERY_SONY_3_SSH_PASSWORD=
RECOVERY_SONY_3_RECOVERY_COMMAND=/data/data/com.termux/files/home/all_in_one.sh start
RECOVERY_SONY_3_ENABLED=true
RECOVERY_SONY_3_STALL_TIMEOUT=1800
RECOVERY_SONY_3_RECOVERY_COOLDOWN=1800
RECOVERY_SONY_3_RECOVERY_TIMEOUT=90
RECOVERY_SONY_3_ACTIVE_HOUR_START=6
RECOVERY_SONY_3_ACTIVE_HOUR_END=23

# ============================================
# 虚拟环境路径
# ============================================
VENV_PATH=/Users/mac/asr_env
